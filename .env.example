# ---- LINE Messaging API ----
# LINE Developers Console > Messaging API channel
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
# LIFF app id (LINE Login channel > LIFF)
LIFF_ID=
# The LINE Login channel id itself (same channel LIFF_ID lives under) — used
# server-side to verify LIFF ID tokens. Different id from the channel above.
LIFF_CHANNEL_ID=

# ---- Database ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/familys_management

# ---- Server ----
PORT=3000
# Public https base url (cloudflared tunnel while developing)
PUBLIC_BASE_URL=http://localhost:3000
TZ=Asia/Bangkok

# ---- Push budget (see plan: LINE free plan ~500 push/month) ----
# Reconciled daily against LINE's own counter; used as the fallback ceiling.
PUSH_MONTHLY_QUOTA=500
# Below this many remaining pushes, urgent lane is suppressed and only digests go out.
PUSH_RESERVE_THRESHOLD=60
DIGEST_MORNING_HOUR=7
DIGEST_EVENING_HOUR=20

# ---- LLM (hybrid fallback only; system works fully with this disabled) ----
# Master switch. "false" removes OpenAiIntentParser from the chain entirely.
AI_ENABLED=true
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5-mini
# Vision model for reading bank slips / receipts (used via the Responses API,
# not Chat Completions — see src/intent/VisionParser.ts). gpt-4o-mini is
# confirmed to accept image input; the gpt-5 family's vision support was
# unclear as of the pricing docs checked when this was built.
OPENAI_VISION_MODEL=gpt-4o-mini
# Per-module AI opt-out — comma-separated. "intent" gates the text fallback
# parser, "receipts" gates photo OCR. Health data stays local by default;
# add "receipts" here too if slips should never leave the server either.
AI_MODULES_DISABLED=meds
